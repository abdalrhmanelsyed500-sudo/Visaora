# Public URL used for canonical URLs, sitemap and social metadata.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL connection used by Prisma in production or when running the database scripts.
DATABASE_URL="postgresql://visaora:password@localhost:5432/visaora?schema=public"

# Set to false outside local development once an authenticated admin session is wired in.
ADMIN_PREVIEW="true"

# Optional future integrations. No paid API is required for the current product.
# ANALYTICS_PROVIDER=""
